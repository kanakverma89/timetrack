# Copy to .env and replace every placeholder. Never commit .env.

# --- application -----------------------------------------------------------
APP_ENV=development            # development | test | production
APP_NAME=TimeTrack
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# ENABLE_DOCS=true             # OpenAPI docs: on in development/test, off in production unless set

# --- database --------------------------------------------------------------
# Used by docker compose to create the local database container.
POSTGRES_USER=timetrack
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=timetrack
DB_PORT=5432
# Must match the values above.
DATABASE_URL=postgresql+psycopg://timetrack:change-me-db-password@localhost:5432/timetrack
# Optional: defaults to the DATABASE_URL with the database name replaced by "timetrack_test".
# TEST_DATABASE_URL=

# --- web / auth ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=local
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=timetrack_session
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- business rules --------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Kolkata
WEEK_START_DAY=MONDAY
MAX_HOURS_PER_ENTRY=24
DESCRIPTION_MAX_LENGTH=256

# --- seed / e2e (synthetic accounts only) ----------------------------------
# Password given to every seeded account. Minimum 12 characters.
SEED_PASSWORD=replace-with-a-seed-password

# --- frontend (no secrets here) --------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
